  "item": [
    {
      "name": "1. Authentication & Security",
      "item": [
        {
          "name": "Signup Customer (USER)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set(\"userToken\", jsonData.token);",
                  "    console.log(\"Saved userToken from customer registration\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Aman Verma\",\n  \"email\": \"aman.verma@example.com\",\n  \"password\": \"Password@123\",\n  \"phone\": \"9876543210\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/signup/user",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "signup",
                "user"
              ]
            },
            "description": "Public customer signup. Server automatically assigns Role.USER and AccountStatus.ACTIVE, and issues a 24-hr JWT."
          }
        },
        {
          "name": "Signup Mess Owner (OWNER)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.user && jsonData.user.id) {",
                  "    pm.collectionVariables.set(\"ownerUserId\", jsonData.user.id);",
                  "    console.log(\"Saved ownerUserId for admin verification: \" + jsonData.user.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Karan Joshi\",\n  \"email\": \"karan.owner@example.com\",\n  \"password\": \"OwnerPass@123\",\n  \"phone\": \"9812345678\",\n  \"businessName\": \"Karan Bhojnalaya & Tiffin Service\",\n  \"businessDescription\": \"Authentic North Indian thali, wholesome tiffin packages, and hygienic home-style meal service for students.\",\n  \"businessAddress\": \"Plot 12, Clock Tower, Rajpur Road, Dehradun\",\n  \"fssaiLicenseNumber\": \"12345678901234\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/signup/owner",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "signup",
                "owner"
              ]
            },
            "description": "Public mess owner signup. Role is set to OWNER and status to PENDING. No JWT is issued until admin verifies the account."
          }
        },
        {
          "name": "Signin - Customer (USER)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set(\"userToken\", jsonData.token);",
                  "    console.log(\"Updated userToken\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }

    {
      "name": "3. Mess Listing & Owner Management",
      "item": [
        {
          "name": "Create Mess Listing",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.id) {",
                  "    pm.collectionVariables.set(\"messId\", jsonData.data.id);",
                  "    console.log(\"Saved newly created messId: \" + jsonData.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Annapurna Royal Mess\",\n  \"description\": \"Premium pure veg North Indian meals with unlimited chapatis, salad, dessert on weekends, and hygienic RO water.\",\n  \"address\": \"45/2 Subhash Nagar, Near Graphic Era University\",\n  \"city\": \"Dehradun\",\n  \"state\": \"Uttarakhand\",\n  \"pincode\": \"248002\",\n  \"latitude\": 30.2687,\n  \"longitude\": 77.9942,\n  \"contactNumber\": \"9876543210\",\n  \"monthlyPrice\": 3200.0,\n  \"foodType\": \"VEG\",\n  \"openingTime\": \"07:30\",\n  \"closingTime\": \"22:00\",\n  \"facilities\": [\n    \"RO Water\",\n    \"High-Speed WiFi\",\n    \"AC Dining Hall\",\n    \"Dedicated Parking\",\n    \"Weekend Special Sweets\"\n  ]\n}"
            },

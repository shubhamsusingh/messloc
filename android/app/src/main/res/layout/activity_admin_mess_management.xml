<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/adminMessManagementRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FB">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:paddingHorizontal="8dp"
        app:title="Mess Management"
        app:titleTextColor="#172554"
        app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:contentInsetStartWithNavigation="0dp"
        app:titleMarginStart="8dp" />

    <!-- Description -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="18dp"
        android:text="Manage Mess Registrations"
        android:textColor="#172554"
        android:textSize="20sp"
        android:textStyle="bold" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="18dp"
        android:text="Review mess registrations submitted by owners."
        android:textColor="#64748B"
        android:textSize="14sp"
        android:lineSpacingExtra="3dp" />

    <!-- Loading -->
    <ProgressBar
        android:id="@+id/messManagementProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <!-- Error -->
    <TextView
        android:id="@+id/messManagementError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="#FEE2E2"
        android:padding="12dp"
        android:textColor="#DC2626"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/messManagementEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:gravity="center"
        android:text="No pending mess registrations."
        android:textColor="@color/primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Pending Mess List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPendingMesses"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        android:scrollbars="vertical"
        android:overScrollMode="never" />

</LinearLayout>
